# Copy to .env.local, edit paths, and source it from the repository root.
export DCCP_ROOT="$(pwd)"
export DCCP_ASSET_ROOT="$DCCP_ROOT/assets"
export POLICY="/path/to/base_openvla_oft_coffee"
export STAT="$POLICY/dataset_statistics.json"
export DCCP_WORLD_MODEL_PATH="/path/to/coffee_world_model/ema.pt"
export DCCP_VAE_PATH="/path/to/world_model_vae"
export DCCP_DATASET_HDF5="/path/to/mimicgen/coffee_D0.hdf5"
export LRM_COMPLETION_MODEL_PATH="/path/to/lrm/progress"
export LRM_PROGRESS_MODEL_PATH="$LRM_COMPLETION_MODEL_PATH"
export LRM_COMPLETION_GOAL_IMAGE="$DCCP_ROOT/Large-Reward-Models/frame_000229.jpg"
export COMPLETION_ENDPOINT="http://127.0.0.1:8001/completion"
export PROGRESS_ENDPOINT="http://127.0.0.1:8002/progress"
export CUDA_VISIBLE_DEVICES=0
export N_GPUS=1
# Start LRMs in their own Python environment; choose service GPU IDs separately.
